; Spend.v1 canonical payload map (labels 0..7)
spend_v1 = {
  0: uint,               ; v
  1: bstr .size 16,      ; spend_id
  2: [+ bstr .size 16],  ; token_ids
  3: uint,               ; value_units
  4: tstr,               ; currency
  5: tstr,               ; payee
  6: uint,               ; created_at_ms
  7: bstr .size 16       ; nonce
}
